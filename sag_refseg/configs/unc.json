{
  "dataset": "unc",
  "data_name": "coco",
  "crop_size": 384,
  "img_backbone": "vit_small_patch16_384",
  "embed_dim": 512,
  "img_num_embeds": 36,
  "img_finetune": true,
  "txt_finetune": true,
  "batch_size": 32,
  "num_epochs": 50,
  "lr": 1e-5,
  "optimizer": "adamw",
  "lr_scheduler": "cosine",
  "lr_warmup_iter": 5000,
  "img_lr_scale": 0.1,
  "img_spm_lr_scale": 1.0,
  "txt_lr_scale": 1.0,
  "agg_depth": 6,
  "agg_cross_head": 4,
  "agg_cross_dim": 256,
  "agg_latent_head": 8,
  "agg_latent_dim": 128,
  "agg_weight_sharing": true,
  "agg_input_dim": 512,
  "agg_query_dim": 512,
  "agg_self_per_cross_attn": 1,
  "agg_query_type": "entity",
  "agg_cross_attn_type": "slot",
  "agg_var_scaling": 1.0,
  "cascade_factor": 3,
  "num_layers": 12,
  "margin": 0.1,
  "cma_criterion": "info_nce",
  "cma_detach_target": true,
  "recon_weight": 1.0,
  "decoder_normalizer": "softmax",
  "pseudo_threshold": 0.5,
  "amp": true,
  "wandb_group": "sag_refseg"
}
